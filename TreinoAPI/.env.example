# Ative o envio depois de configurar um remetente verificado no provedor.
Email__Enabled=true
Email__BrandName=GGP
Email__SenderName=GGP | Gestão de Performance
Email__SenderEmail=contato@seudominio.com
Email__ReplyToEmail=contato@seudominio.com
Email__LogoUrl=
Email__PrimaryColor=#5558D9

# Exemplo de SMTP com STARTTLS (587). Para provedores com TLS implícito (465), ajuste a porta.
Email__Smtp__Host=smtp.seuprovedor.com
Email__Smtp__Port=587
Email__Smtp__Username=seu-usuario-smtp
Email__Smtp__Password=sua-senha-ou-chave-smtp
Email__Smtp__EnableSsl=true
Email__Smtp__TimeoutMs=20000

# Chat: anexos ficam fora de wwwroot e só são publicados depois de passar pelo antivírus.
CHAT_FILES_STORAGE_PATH=App_Data/chat-anexos
CHAT_ANTIVIRUS_COMMAND=clamscan
CHAT_ANTIVIRUS_ARGUMENTS=--no-summary "{file}"

# Opcional: token de acesso do Expo para projetos com Enhanced Push Security.
EXPO_ACCESS_TOKEN=
