# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=treino_system
DB_USER=postgres
DB_PASSWORD=change-me

# Segredo aleatório com pelo menos 32 bytes. Gere um valor exclusivo para cada ambiente.
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Origens exatas permitidas para o frontend
FRONTEND_ORIGINS=http://localhost:5173

# Conta administrativa inicial; criada somente se ainda não existir.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-chars
