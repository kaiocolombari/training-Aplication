# Copie para .env apenas no ambiente local. Nunca versione .env ou use valores de exemplo em produção.
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=treino_system
DB_USER=treino_system_app
DB_PASSWORD=

# Gere um segredo aleatorio exclusivo com pelo menos 32 bytes.
AUTH_JWT_SECRET=
Auth__Issuer=TreinoAPI
Auth__Audience=TreinoWeb
Auth__AccessTokenMinutes=15
Auth__RefreshTokenDays=7

# Origens completas do frontend separadas por ponto e virgula.
# Em producao use somente HTTPS e os dominios definitivos.
FRONTEND_ORIGINS=http://localhost:5173

# Em producao, defina AllowedHosts com o hostname publico da API (sem wildcard).
AllowedHosts=localhost

# Ative somente quando a API estiver atras de um proxy reverso confiavel.
# Informe os IPs reais do proxy, nao os IPs enviados pelo cliente.
FORWARDED_HEADERS_ENABLED=false
FORWARDED_TRUSTED_PROXIES=

# Criado somente se ainda nao existir uma conta ADMIN.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Armazenamento privado (fora de wwwroot).
TEAM_FILES_STORAGE_PATH=App_Data/arquivos-equipe
CHAT_FILES_STORAGE_PATH=App_Data/chat-anexos

# Anexos do chat falham de forma segura se o antivirus nao estiver configurado.
# Exemplo Linux: /usr/bin/clamscan
CHAT_ANTIVIRUS_COMMAND=
CHAT_ANTIVIRUS_ARGUMENTS=--no-summary "{file}"

# Push remoto opcional (token de acesso do Expo).
EXPO_ACCESS_TOKEN=

# E-mail transacional opcional.
Email__Enabled=false
Email__BrandName=Treino System
Email__SenderName=Treino System
Email__SenderEmail=no-reply@example.com
Email__ReplyToEmail=
Email__LogoUrl=
Email__PrimaryColor=#17211B
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__EnableSsl=true
Email__Smtp__TimeoutMs=15000
